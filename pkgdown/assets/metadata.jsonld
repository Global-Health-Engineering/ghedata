    "name": "Lars Schöbitz",
    "sameAs": "https://orcid.org/0000-0003-2196-5015",
    "email": "lschoebitz@ethz.ch"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Global-Health-Engineering",
    "url": "https://github.com/Global-Health-Engineering"
  },
  "funder": [
    {
      "@type": "Person",
      "givenName": "Elizabeth",
