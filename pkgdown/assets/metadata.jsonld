{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Data on the Work of the Global Health Engineering Group",
  "alternateName": "ghedata",
  "description": "Data that documents the work of the Global Health Engineering group at ETH Zurich since 2021: theses, projects and staff, computational competencies of the group, repositories and commits on GitHub, funding proposals, and records on Zenodo with their views and downloads.",
  "version": "0.0.0.9000",
  "url": "https://global-health-engineering.github.io/ghedata/",
  "datePublished": "2026-11-18",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "isAccessibleForFree": true,
  "keywords": ["open data", "global health", "research group", "research data management", "data stewardship", "GitHub", "funding proposals", "Switzerland"],
  "creator": [
    {
      "@type": "Person",
      "givenName": "Lars",
      "familyName": "Schöbitz",
