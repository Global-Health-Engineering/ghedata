    }
  ],
  "spatialCoverage": {
    "@type": "Place",
    "name": "Zurich, Switzerland"
  },
  "temporalCoverage": "2021-02-01/2026-11-18",
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "people.project_id",
      "description": " Unique identifier for each person using a combination of other metadata. Folder name on Google Drive."
    },
    {
      "@type": "PropertyValue",
      "name": "people.degree",
      "description": " Categorical variable with four levels: bsc, msc, phd, staff."
    },
    {
      "@type": "PropertyValue",
      "name": "people.type",
      "description": " Categorical variable with six levels: hiwi, intern, post-doc, scientific-assitant, sem-proj, thesis."
    },
    {
      "@type": "PropertyValue",
      "name": "people.b_m_student",
      "description": " Binary variable to identify if person is BSc or MSc students. Levels: yes, no."
    },
    {
      "@type": "PropertyValue",
      "name": "people.start_date",
      "description": " Start date of the person."
    },
    {
      "@type": "PropertyValue",
      "name": "people.year",
      "description": " Year of the start date."
    },
    {
      "@type": "PropertyValue",
      "name": "people.thesis_title",
      "description": " Title of the thesis."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.id",
      "description": " Unique identifier for each survey respondent."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.experience_programming_general",
      "description": " Self-reported experience with programming in general."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.experience_programming_r",
      "description": " Self-reported experience with programming in R."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.experience_programming_python",
      "description": " Self-reported experience with programming in Python."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.other_languages",
      "description": " Other programming languages or software the respondent has experience with (comma-separated)."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.programming_confidence",
      "description": " Self-reported confidence in writing a program to find the largest number in a list."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.experience_git",
      "description": " Self-reported experience with using Git."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.experience_github",
      "description": " Self-reported experience with using GitHub."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.data_storage_format",
      "description": " Primary format used for data storage."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.document_writing_approach",
      "description": " Approach to writing narrative documents that include text and analysis."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.experience_ides",
      "description": " Self-reported experience with using Integrated Development Environments (IDEs)."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.ides_used",
      "description": " IDEs that the respondent has used (comma-separated list)."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.cli_usage",
      "description": " Self-reported usage of command-line interface on their operating system."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.llm_usage",
      "description": " Self-reported usage of Language Learning Models (LLMs) for various tasks."
    },
    {
      "@type": "PropertyValue",
      "name": "computational.llm_tools_used",
      "description": " LLM tools or platforms used for research, ideation, writing, or coding (comma-separated list)."
    },
    {
      "@type": "PropertyValue",
      "name": "github_organisations.organisation",
      "description": " Login of the GitHub organisation. An organisation account, not a person."
    },
    {
      "@type": "PropertyValue",
      "name": "github_organisations.purpose",
      "description": " What the organisation is used for. Levels: research, data publishing, development, events, training, teaching."
    },
    {
      "@type": "PropertyValue",
      "name": "github_organisations.commits_counted",
      "description": " TRUE when the commits of the organisation are counted in github_commits. FALSE for teaching organisations with one repository per student, which appear with repository counts only."
    },
    {
      "@type": "PropertyValue",
      "name": "github_organisations.created_date",
      "description": " Date the organisation was created on GitHub."
    },
    {
      "@type": "PropertyValue",
      "name": "github_organisations.repos_public",
      "description": " Number of public repositories on the snapshot date."
    },
    {
      "@type": "PropertyValue",
      "name": "github_organisations.repos_private",
      "description": " Number of private repositories on the snapshot date. A count only, private repositories are never named."
    },
    {
      "@type": "PropertyValue",
      "name": "github_organisations.repos_archived",
      "description": " Number of archived repositories on the snapshot date. NA for organisations whose commits are not counted."
    },
    {
      "@type": "PropertyValue",
      "name": "github_organisations.repos_listed",
      "description": " Number of public repositories of the organisation that are rows of github_repositories."
    },
    {
      "@type": "PropertyValue",
      "name": "github_organisations.snapshot_date",
      "description": " Date (UTC) on which the data was read from the GitHub API."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repositories.organisation",
      "description": " Login of the GitHub organisation that owns the repository."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repositories.repository",
      "description": " Name of the public repository."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repositories.created_date",
      "description": " Date the repository was created."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repositories.pushed_date",
      "description": " Date of the last push to the repository before the snapshot date."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repositories.is_archived",
      "description": " TRUE when the repository is archived."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repositories.is_fork",
      "description": " TRUE when the repository is a fork of another repository."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repositories.license",
      "description": " SPDX identifier of the licence that GitHub detects. NA when there is none or GitHub cannot name it."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repositories.primary_language",
      "description": " Main language of the repository as detected by GitHub. NA when there is none."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repositories.repository_type",
      "description": " Type of the repository, see github_repository_types for the rules. Levels in this table: data package, student project, hardware, manuscript, organisation profile, proposal or report, research project, software, teaching and training, template, website and communication, group management."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repositories.commits_total",
      "description": " Number of commits on the default branch up to the last complete month before the snapshot date, made by people, without merge commits, commits by bots and automated commits. NA for forks."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repository_types.organisation",
      "description": " Login of the GitHub organisation."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repository_types.visibility",
      "description": " Visibility of the repositories on the snapshot date. Levels: public, private."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repository_types.repository_type",
      "description": " Type of the repositories, from rules on the name, the top level files, the topics, the main language and the purpose of the organisation. Levels: learner repository, organisation profile, data package, student project, manuscript, proposal or report, teaching and training, website and communication, template, group management, software, hardware, research project."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repository_types.created_year",
      "description": " Year the repositories were created."
    },
    {
      "@type": "PropertyValue",
      "name": "github_repository_types.repos",
      "description": " Number of repositories. A count only, no repository is named."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits.organisation",
      "description": " Login of the GitHub organisation."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits.visibility",
      "description": " Visibility of the repositories on the snapshot date. Levels: public, private."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits.month",
      "description": " First day of the month (UTC) in which the commits were authored."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits.commits",
      "description": " Number of commits made by people on the default branches, without merge commits, commits by bots and automated commits. Forks are not counted."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits.commits_bot",
      "description": " Number of commits authored by bot accounts and by GitHub Actions. Not part of commits."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits.commits_automated",
      "description": " Number of commits pushed by a device or a script under the account of a person, such as sensor data on a schedule. Recognised by the first line of the message with the patterns in data-raw/github_automated_commits.csv. Not part of commits."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits.commits_merge",
      "description": " Number of merge commits (more than one parent) that are neither by bots nor automated. Not part of commits."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits.commits_assisted",
      "description": " Number of commits counted in commits whose message carries a trailer of a coding agent (Co-Authored-By for Claude or Copilot, Assisted-by, or the Claude Code line). A lower bound, since the trailer is optional."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits.repos_active",
      "description": " Number of repositories with at least one commit counted in commits in that month."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_type.organisation",
      "description": " Login of the GitHub organisation."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_type.visibility",
      "description": " Visibility of the repositories on the snapshot date. Levels: public, private."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_type.repository_type",
      "description": " Type of the repositories, see github_repository_types for the levels and the rules."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_type.month",
      "description": " First day of the month (UTC) in which the commits were authored."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_type.commits",
      "description": " Number of commits made by people on the default branches, without merge commits, commits by bots and automated commits. Forks are not counted. Adds up to commits in github_commits."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_type.commits_bot",
      "description": " Number of commits authored by bot accounts and by GitHub Actions. Not part of commits."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_type.commits_automated",
      "description": " Number of commits pushed by a device or a script under the account of a person. Not part of commits."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_type.commits_assisted",
      "description": " Number of commits counted in commits whose message carries a trailer of a coding agent. A lower bound, since the trailer is optional."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_type.repos_active",
      "description": " Number of repositories of that type with at least one commit by a person in that month."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.proposal_id",
      "description": "Identifier of the proposal, numbered in the order of submission. Carries no name of a project or a person."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.project_id",
      "description": "Identifier of the project. Proposals with the same project_id are requests for the same project to different funders or in different years."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.status",
      "description": "Status of the proposal. Levels: accepted, rejected, submitted (no answer yet), withdrawn."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.submitted_date",
      "description": "Date the proposal was submitted. Where only the month is known, the first day of the month."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.submitted_year",
      "description": "Year the proposal was submitted."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.answer_date",
      "description": "Date of the answer of the funder. Where only the month is known, the first day of the month. NA when no answer was recorded."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.days_to_answer",
      "description": "Days between submission and answer. NA when no answer was recorded or when the recorded answer lies before the submission."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.funder",
      "description": "Funder or funding programme the proposal was submitted to, with one spelling per funder."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.snsf",
      "description": "TRUE when the proposal went to a programme of the Swiss National Science Foundation."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.budget",
      "description": "Requested budget in the currency of the proposal."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.currency",
      "description": "Currency of the requested budget (ISO 4217 code)."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.rate_date",
      "description": "Date of the exchange rate used for budget_chf: 1 July of the year of submission, or the last banking day before it. NA for budgets in CHF."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.budget_chf",
      "description": "Requested budget in Swiss francs, rounded to the franc. Converted with the reference rate of the European Central Bank on rate_date. NA when the budget or the currency is missing."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.lead_data_steward",
      "description": "TRUE when the data steward of the group led the proposal. The only information on a lead in the data."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.co_lead_external",
      "description": "TRUE when the proposal had a co-lead outside the group."
    },
    {
      "@type": "PropertyValue",
      "name": "proposals.partner_organisation",
      "description": "TRUE when the proposal named a partner organisation."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_person.person_rank",
      "description": "Rank of the person by number of commits, 1 for the most commits. Stands in for the person; no login or name is kept."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_person.commits",
      "description": "Commits by the person in the twelve months from first_month to last_month, counted as in github_commits (no bots, no automated pushes, no merge commits) and without commits in the training organisations."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_person.commits_assisted",
      "description": "Number of these commits that carry an agent trailer."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_person.share_assisted",
      "description": "commits_assisted divided by commits. Empty for a person with 0 commits."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_person.workshop",
      "description": "Part in the workshops of the group in the twelve months: participant (has commits in a training organisation), trainer (ran the workshops) or none."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_person.first_month",
      "description": "First month of the twelve months counted."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_person.last_month",
      "description": "Last month of the twelve months counted."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_members.month",
      "description": "First day of the month."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_members.commits",
      "description": "Commits by group members in the month, without commits in the training organisations."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_members.commits_assisted",
      "description": "Number of these commits that carry an agent trailer."
    },
    {
      "@type": "PropertyValue",
      "name": "github_commits_by_members.lookup_complete",
      "description": "TRUE for the months in which every person was checked against the lookup of group members."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.record_id",
      "description": "Identifier of the record on Zenodo (latest version)."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.doi",
      "description": "DOI of the latest version."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.title",
      "description": "Title of the record."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.publication_date",
      "description": "Publication date of the latest version."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.resource_type",
      "description": "Type of the record on Zenodo, for example dataset, software, publication."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.openwashdata_community",
      "description": "TRUE if the record is part of the openwashdata community on Zenodo."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.views",
      "description": "Views of the record page, all versions."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.unique_views",
      "description": "Unique views, all versions, as counted by Zenodo."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.downloads",
      "description": "Downloads of files, all versions."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.unique_downloads",
      "description": "Unique downloads, all versions, as counted by Zenodo."
    },
    {
      "@type": "PropertyValue",
      "name": "zenodo_records.snapshot_date",
      "description": "Date on which the counts were read."
    }
  ],
  "distribution": [
